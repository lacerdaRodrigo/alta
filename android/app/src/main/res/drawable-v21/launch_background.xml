<?xml version="1.0" encoding="utf-8"?>
<!-- Tela exibida pelo sistema enquanto o processo sobe.
     Usa o mesmo gradiente da marca (FisioGradients.header) para que a
     TelaSplash do Flutter entre sem nenhum flash branco. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="@color/fisio_primary_light"
                android:centerColor="@color/fisio_primary"
                android:endColor="@color/fisio_primary_dark"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
